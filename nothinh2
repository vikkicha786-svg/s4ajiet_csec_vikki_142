import java.util.HashSet;

public class Main {
    public static void main(String[] args) {

        HashSet<String> set = new HashSet<>();

        set.add("Apple");
        set.add("Banana");
        set.add("Apple");
        set.add("Mango");

        System.out.println("HashSet Size: " + set.size());
        System.out.println("Elements in HashSet: " + set);

    }
}
