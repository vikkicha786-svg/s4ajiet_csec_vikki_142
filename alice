import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int m = sc.nextInt();
        int n = sc.nextInt();

        int count = 0;

        for (int x = 1; x <= m; x++) {
            for (int y = 1; y <= n; y++) {

                System.out.println(x + "," + y);

                if ((x + y) % 2 == 1) {
                    count++;
                }
            }
        }

        System.out.println("Count = " + count);

        sc.close();
    }
}
