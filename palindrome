class Main {
    public static void main(String[] args) {

        int num = 121;
        int original = num;
        int reverse = 0;

        while(num != 0) {

            int digit = num % 10;
            reverse = reverse * 10 + digit;
            num = num / 10;
        }

        System.out.println("Reverse Number is: " + reverse);

        if(original == reverse) {
            System.out.println("Palindrome Number");
        } else {
            System.out.println("Not a Palindrome Number");
        }
    }
}
